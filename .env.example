# ============================================================================
# CoBuy environment template
# Copy to .env and fill in real values. Never commit .env.
# ============================================================================

# --- Server ----------------------------------------------------------------
# Leave PORT unset on a hosting platform: it injects its own port.
# Locally, 5000 is taken by macOS AirPlay, so prefer 5055.
PORT=5055
# development | production. Set NODE_ENV=production when hosting: the server
# then refuses to start with a missing or placeholder JWT secret.
NODE_ENV=development

# --- Database (MySQL 8.0+) -------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cobuy_db

# Prisma connection URL (must match the DB_* values above)
DATABASE_URL="mysql://root:@localhost:3306/cobuy_db"

# --- Authentication (JWT) --------------------------------------------------
# REQUIRED in production. Must not be a template value and must be at least
# 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=24h
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=7

# --- CORS ------------------------------------------------------------------
# Comma-separated extra browser origins allowed to call the API, e.g.
# https://app.example.com. The SPA is served from this same origin, so this
# can stay empty when hosting. There is no wildcard.
CORS_ORIGINS=

# --- OAuth2 / OpenID Connect (optional) ------------------------------------
# Real Google credentials are required for OIDC sign-in. There is no mock mode:
# an unconfigured provider returns 503 and invalid codes are rejected.
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URI=http://localhost:5055/api/users/oauth/callback
