# Server Configuration
PORT=5000

# Database Configuration (MySQL 8.0+)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cobuy_db

# Prisma Connection URL
DATABASE_URL="mysql://root:@localhost:3306/cobuy_db"

# Authentication (JWT)
JWT_SECRET=cobuy_development_secret_key_change_in_production
JWT_EXPIRES_IN=24h
