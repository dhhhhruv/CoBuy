# ============================================================================
# CoBuy environment template
# Copy to .env and fill in real values. Never commit .env.
# ============================================================================

# --- Server ----------------------------------------------------------------
# Leave PORT unset on a hosting platform: it injects its own port.
# Locally, 5000 is taken by macOS AirPlay, so prefer 5055.
PORT=5055

# --- Database (MySQL 8.0+) -------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cobuy_db

# Prisma connection URL (must match the DB_* values above)
DATABASE_URL="mysql://root:@localhost:3306/cobuy_db"

# --- Authentication (JWT) --------------------------------------------------
# Generate a long random value for any deployed environment.
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=24h
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=7

# --- OAuth2 / OpenID Connect (optional) ------------------------------------
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URI=http://localhost:5055/api/users/oauth/callback

# Must be false in production: mock mode accepts any authorization code and
# /api/users/oauth/mock creates accounts without a password.
OAUTH_MOCK_MODE=false
